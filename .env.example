# ==========================================
# Hackathon Showcase Bot & Dashboard Config
# ==========================================

# Discord Bot Credentials
# Get these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_target_server_id_here

# Channel IDs for automated features
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_INBOX_CHANNEL_ID=

# Backend & API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_to_a_secure_random_string_in_production
ADMIN_API_KEY=dev_admin_key_12345

# Database Configuration (SQLite default with async support)
DATABASE_URL=sqlite+aiosqlite:///./data/showcase.db

# Bot & Team Customization
TEAM_NAME=DevUpward
TEAM_MOTTO=Building the future, one hackathon at a time
BRAND_COLOR=#5865F2

# Cloudinary Image Storage (for uploads from dashboard)
# Get these free from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


